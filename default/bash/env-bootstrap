# Single source of truth for OMAKALI_PATH / OMARCHY_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/omakali.sh, /etc/profile.d/omarchy.sh (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-omarchy          (Hyprland session via uwsm)
#   /usr/share/omarchy/default/bash/envs      (bash rc chain; SSH/non-login)

if [ -f /etc/omakali.conf ]; then
  . /etc/omakali.conf
  : "${OMAKALI_PATH:=/usr/share/omakali}"
  : "${OMARCHY_PATH:=$OMAKALI_PATH}"
elif [ -f /etc/omarchy.conf ]; then
  . /etc/omarchy.conf
  : "${OMARCHY_PATH:=/usr/share/omarchy}"
  : "${OMAKALI_PATH:=$OMARCHY_PATH}"
else
  OMAKALI_PATH=/usr/share/omakali
  OMARCHY_PATH=/usr/share/omarchy
fi
export OMAKALI_PATH OMARCHY_PATH

# Only prepend in dev-link mode.
if [ "$OMARCHY_PATH" != /usr/share/omarchy ] && [ -d "${OMARCHY_PATH%/}/bin" ]; then
  case ":$PATH:" in
    *":${OMARCHY_PATH%/}/bin:"*) ;;
    *) PATH="${OMARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi
if [ "$OMAKALI_PATH" != /usr/share/omakali ] && [ -d "${OMAKALI_PATH%/}/bin" ]; then
  case ":$PATH:" in
    *":${OMAKALI_PATH%/}/bin:"*) ;;
    *) PATH="${OMAKALI_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
